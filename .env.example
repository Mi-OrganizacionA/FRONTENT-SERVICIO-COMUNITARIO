# Entorno de Desarrollo Local
NODE_ENV=development
PORT=3000

# Base de datos (Por defecto usa SQLite en desarrollo si no se especifica postgres)
# DB_TYPE=sqlite
# DB_PATH=database.sqlite

# Configuración JWT
JWT_SECRET=tu_secret_desarrollo_seguro
JWT_EXPIRE=24h

# CORS y seguridad
# Lista de orígenes permitidos separados por coma.
ALLOWED_ORIGINS=http://localhost:8080,https://sicag-oficial.web.app
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

#=============================================
# CONFIGURACIÓN PARA PRODUCCIÓN (Ejemplo)
#=============================================
# NODE_ENV=production
# PORT=3000

# Conexión Base de Datos PostgreSQL
# DB_TYPE=postgres
# DB_HOST=tu-servidor-postgres.com
# DB_PORT=5432
# DB_NAME=sicag_db
# DB_USER=usuario_prod
# DB_PASS=clave_segura

# Servicio de Correo (SMTP) para recuperación de contraseñas
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=tu_clave_de_aplicacion_gmail

# Configuración JWT Producción
# JWT_SECRET=una_cadena_aleatoria_super_larga_y_segura
# JWT_EXPIRE=24h
